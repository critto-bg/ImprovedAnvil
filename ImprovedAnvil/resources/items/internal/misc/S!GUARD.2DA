2DA V1.0
*
HDR   UNID_NAME    0         // "<NO TEXT>"
HDR   NAME         0         // "<NO TEXT>"
HDR   FLAGS        0x00000068  // displayable, cannot scribe, magical
HDR   TYPE         10        // ring
HDR   PRICE        55000
HDR   ICON_INV     IRING07
HDR   ICON_GROUND  GRING01
HDR   UNID_DESC    30        // ""
HDR   DESC         30        // ""
HDR   ICON_DESC    CRING07
#FX  lst  op   tgt  pow  p1     p2  tim  dsp  dur  pr1  pr2  resource  dn  ds  sav  sb  spc
FX   E    193  -    -    -      1   -    -    -    -    -    -         -   -   -    -   -  // Spell Effect: Invisible Detection by Script (0,1)
FX   E    101  -    -    -      38  -    -    -    -    -    -         -   -   -    -   -  // Protection: from Opcode #38 (State: Silence)
FX   E    48   -    -    -      -   -    -    -    -    -    -         -   -   -    -   -  // Cure: Silence (Vocalize)
FX   E    267  -    -    14002  -   -    -    -    -    -    -         -   -   -    -   -  // Text: Protection from Display Specific String: "Silence"
