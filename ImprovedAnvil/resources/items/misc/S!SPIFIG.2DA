2DA V1.0
*
SAY   NAME2  294          // ~Golden Spider Figurine~
SAY   DESC   295
HDR   KIT4         0x02      // unusable by: Wizard Slayer
HDR   PRICE        2000
HDR   ICON_INV     S!SPIDIN
HDR   ICON_GROUND  GSACK01
HDR   ICON_DESC    CMISC3E
#FX  lst  op   tgt  pow  p1  p2  tim  dsp  dur  pr1  pr2  resource  dn  ds  sav  sb  spc
ABIL  0  ATTACK_TYPE  3
ABIL  0  LOCATION     3
ABIL  0  ICON         S!SPIDIN
ABIL  0  TARGET       4
ABIL  0  RANGE        20
ABIL  0  DICE_THROWN  0
ABIL  0  CHARGES      1
ABIL  0  DEPLETION    3
ABIL  0  FLAGS        0x00000800  // recharges
#FX  lst  op   tgt  pow  p1  p2  tim  dsp  dur  pr1  pr2  resource  dn  ds  sav  sb  spc
FX   0    174  1    -    -   -   -    -    -    -    -    EFF_P115  -   -   -    -   -  // Spell Effect: Play Sound Effect ~EFF_P115~
FX   0    177  1    -    -   2   0    -    180  -    -    S!SPIDER  -   -   -    -   -  // Use EFF File ~S!SPIDER~: target EA ANYONE
