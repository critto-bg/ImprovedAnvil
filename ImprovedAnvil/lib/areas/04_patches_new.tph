// Patch the new areas //

// Helter Steps
COPY_EXISTING ~s!0001.are~ ~override/s!0001.are~
  LPF fj_are_structure
    INT_VAR
      fj_type       = 1
      fj_box_left   = 785
      fj_box_top    = 1865
      fj_box_right  = 845
      fj_box_bottom = 1900
      fj_loc_x      = 800
      fj_loc_y      = 1890
      fj_cursor_idx = 8
      fj_vertex_0   = (785 + (1860 << 16))
      fj_vertex_1   = (845 + (1865 << 16))
      fj_vertex_2   = (840 + (1910 << 16))
      fj_vertex_3   = (785 + (1900 << 16))
    STR_VAR
      fj_name           = ~Statue~
      fj_reg_script     = ~S!STATUE~
      fj_structure_type = region
  END

  LPF ~ALTER_AREA_REGION~
    INT_VAR
      info_point = RESOLVE_STR_REF (@12069)
    STR_VAR
      region_name = ~Cave1~
  END

  LPF ~ALTER_AREA_REGION~
    INT_VAR
      info_point = RESOLVE_STR_REF (@12069)
    STR_VAR
      region_name = ~Cave2~
  END
BUT_ONLY

