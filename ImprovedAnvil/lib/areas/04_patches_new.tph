// Retire the strings.tph "Exit" override: repoint the automap note off the shared stock
// strref 70904 ("To the Final Seal") to an appended @10154 ("Exit") on IA's own areas
ACTION_FOR_EACH ~area~ IN ~aria11~ ~aria17~ BEGIN
  COPY_EXISTING ~%area%.are~ ~override~
    GET_OFFSET_ARRAY am_notes 0xc4 4 0xc8 4 0 0 0x34
    PHP_EACH am_notes AS _ => am_off BEGIN
      READ_LONG (am_off + 0x04) am_txt
      PATCH_IF (am_txt = 70904) BEGIN WRITE_LONG (am_off + 0x04) RESOLVE_STR_REF (@10154) END
    END
    BUT_ONLY
END
