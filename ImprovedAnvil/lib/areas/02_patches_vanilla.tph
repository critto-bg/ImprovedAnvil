  // disable spawn points 1 & 2 (the original WRITE_LONG here was a typo for
  // WRITE_SHORT: it also zeroed the appearance-schedule low word at 0x88)
  LPF ~S!SET_SPAWN~ INT_VAR enabled = 0 STR_VAR spawn = ~Spawn Point 1~ END
  LPF ~S!SET_SPAWN~ INT_VAR enabled = 0 STR_VAR spawn = ~Spawn Point 2~ END

COPY_EXISTING ~ar2800.are~ ~override/ar2800.are~
  LPF ~S!SET_REST~ STR_VAR cre0 = ~S!coinra~ cre1 = ~S!gemran~ END

  LPF ~S!SET_DEFAULT_TRANSITION_FLAGS~ STR_VAR region_name = ~Tran2807~ END
  LPF ~S!SET_DEFAULT_TRANSITION_FLAGS~ STR_VAR region_name = ~Tran2811~ END
  LPF ~S!SET_DEFAULT_TRANSITION_FLAGS~ STR_VAR region_name = ~Tran2810~ END
  LPF ~S!SET_DEFAULT_TRANSITION_FLAGS~ STR_VAR region_name = ~Tran2802~ END

  LPF ~ALTER_AREA_DOOR~ INT_VAR lock_difficulty = 100 flag_locked = 1 string_unlock = RESOLVE_STR_REF (@10141) STR_VAR door_name = ~Door07~ END

  // repoint the automap note off the shared stock strref 61272 to an appended @10140
  // ("The Sealed House"), instead of clobbering the stock string.
  GET_OFFSET_ARRAY am_notes 0xc4 4 0xc8 4 0 0 0x34
  PHP_EACH am_notes AS _ => am_off BEGIN
    READ_LONG (am_off + 0x04) am_txt
    PATCH_IF (am_txt = 61272) BEGIN WRITE_LONG (am_off + 0x04) RESOLVE_STR_REF (@10140) END
  END

