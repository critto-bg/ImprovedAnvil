COPY_EXISTING ~ar0530.are~ ~override/ar0530.are~
  READ_LONG 0xBC "song-offset"
  WRITE_LONG "%song-offset%" 0
  WRITE_LONG ("%song-offset%" + 4) 0
  WRITE_LONG ("%song-offset%" + 12) 51

  LPF ~S!SET_DEFAULT_TRANSITION_FLAGS~ STR_VAR region_name = ~Tran0500~ END

  EXTEND_BOTTOM ~AR0530.BCS~ ~ImprovedAnvil\scripts\areas\AR0530.BAF~

COPY_EXISTING ~AR0602.ARE~ ~override/AR0602.ARE~

  GET_OFFSET_ARRAY actors ARE_V10_ACTORS

  PHP_EACH actors AS int => off BEGIN
    READ_ASCII   off actor_name (32) NULL

    PATCH_IF "%actor_name%" STRING_EQUAL_CASE "Goblin" BEGIN
      WRITE_ASCII  off         ~Orc~ #32
      WRITE_LONG  (off + 0x30) 59392
      WRITE_ASCII (off + 0x80) ~orc01~ #8
    END
  END

  LAUNCH_PATCH_FUNCTION ~ALTER_AREA_CONTAINER~
    STR_VAR
      container_name = "Table 3"
      container_script = ~~
  END

  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 1315
      fj_loc_y       = 840
      fj_dest_x      = 1315
      fj_dest_y      = 840
      fj_loaded      = 1
      fj_animation   = 24833
      fj_orientation = 3
    STR_VAR
      fj_structure_type = actor
      fj_name           = ~Library Keeper~
      fj_cre_resref     = ~S!libmag~
  END

  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 4110
      fj_loc_y       = 1265
      fj_dest_x      = 4110
      fj_dest_y      = 1265
      fj_loaded      = 1
      fj_animation   = 24833
      fj_orientation = 8
    STR_VAR
      fj_structure_type = actor
      fj_name           = ~Bodyguard~
      fj_cre_resref     = ~S!iguard~
  END

  LPF ~S!SET_SPAWN~ INT_VAR count = 2 STR_VAR spawn = ~Spawn Point 1~ cre1 = ~MEPEAR01~ END
  LPF ~S!SET_SPAWN~ INT_VAR count = 0 STR_VAR spawn = ~Spawn Point 2~ END   // was WRITE_SHORT 0x86 (enabled); corrected to count 0x74
  LPF ~S!SET_SPAWN~ INT_VAR count = 1 STR_VAR spawn = ~Spawn Point 8~ END
  LPF ~S!SET_SPAWN~ STR_VAR spawn = ~Spawn Point 4~  cre0 = ~S!spyran~ END
  LPF ~S!SET_SPAWN~ STR_VAR spawn = ~Spawn Point 9~  cre0 = ~S!spyran~ END
  LPF ~S!SET_SPAWN~ STR_VAR spawn = ~Spawn Point 12~ cre0 = ~S!spyran~ END
  LPF ~S!SET_SPAWN~ STR_VAR spawn = ~Spawn Point 3~  cre0 = ~S!SPIDE3~ END
  LPF ~S!SET_SPAWN~ STR_VAR spawn = ~Spawn Point 11~ cre0 = ~MEPEAR01~ END
  LPF ~S!SET_SPAWN~ INT_VAR method = 2 STR_VAR spawn = ~Spawn Point 13~ cre0 = ~tanthf01~ cre1 = ~tanthf01~ END  // method 2 = disable after spawn

