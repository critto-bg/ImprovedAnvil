  LPF ~S!SET_REST~ INT_VAR clear_name = 1 STR_VAR cre0 = ~S!mistva~ cre2 = ~S!misth1~ END
  LPF ~S!SET_SPAWN~ INT_VAR count = 1 method = 2 STR_VAR spawn = ~Spawn Point 1~ END
  LPF ~S!SET_SPAWN~ INT_VAR count = 1 method = 2 max_num = 1 STR_VAR spawn = ~Spawn Point 2~ cre0 = ~S!spyran~ END
  LPF ~S!SET_SPAWN~ INT_VAR method = 2 max_num = 1 STR_VAR spawn = ~Spawn Point 3~ cre0 = ~S!spyran~ END
  LPF ~S!SET_SPAWN~ INT_VAR method = 2 STR_VAR spawn = ~Spawn Point 4~ END

  EXTEND_BOTTOM ~AR1201.BCS~ ~ImprovedAnvil\scripts\areas\AR1201.BAF~

