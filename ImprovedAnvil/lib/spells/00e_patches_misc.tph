// Haste
COPY_EXISTING ~spra301.spl~ ~override/spra301.spl~
  READ_LONG   0x01e "exclusion"
  WRITE_LONG  0x01e ("%exclusion%" BOR BIT30)  // exclusion flags: + Cleric/Paladin

  // remove the level 6-12 scaling headers (and their effects)
  FOR (lvl = 6; lvl <= 12; lvl += 1) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // every header: all 8 Stat: Fatigue Modifier effects — resist_dispel = 0
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
      match_opcode  = 93
      resist_dispel = 0
  END

  // abil 0 (level 1): State: Haste
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 16
      multi_match   = 1
      duration      = 90
  END

  // abil 0 (level 1): Graphics: Display Special Effect Icon #38 (Haste)
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 142
      multi_match   = 1
      duration      = 90
  END

  // abil 0 (level 1): Spell Effect: Play Sound Effect ~EFF_M29~
