  // abil 0 (level 1): + Spell: Protection from Spell ×3, one per resource below:
  //   Spell: Protection from Spell ~SPCL907~ (Hardiness)
  //   Spell: Protection from Spell ~SPINI26~ (Aura of Invulnerability)
  //   Spell: Protection from Spell ~SPWISH12~ (Hardiness)
  SET ip = 11
  PATCH_FOR_EACH v IN ~SPCL907~ ~SPINI26~ ~SPWISH12~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 206
        target       = 3
        timing       = 0
        duration     = 60
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END

  // abil 1: clone of abil 0 for level 20
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 2 min_level = 20 END
  BUT_ONLY

