/// converted from the pre-edited binary copies (00_copy_vanilla.tph); ///
/// generated by spec/tools/spl_patchgen.py and verified against the   ///
/// shipped binaries, then hand-maintained                             ///

// bddragbl
COPY_EXISTING ~bddragbl.spl~ ~override/bddragbl.spl~

  // Dragon Blade +3, critical hit chance ability
  LPF ALTER_SPELL_EFFECT INT_VAR
    check_headers = 1
    match_opcode = 301
    parameter1 = 1
  END
  BUT_ONLY

// Beguiling Gaze
COPY_EXISTING ~beguile.spl~ ~override/beguile.spl~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT9))  // flags: - breaks sanctuary/invisibility
  WRITE_BYTE  0x025  4  // primary type: Enchanter
  WRITE_BYTE  0x027 11  // secondary type: DISABLING

  // abil 0 (level 1): - all 2 Protection: Immunity to Resource and Message effects:
  //   Protection: Immunity to Resource and Message ~BEGUILE~ (Beguiling Gaze) (0,19)
  //   Protection: Immunity to Resource and Message ~BEGUILE~ (Beguiling Gaze) (0,15)
  LPF DELETE_EFFECT INT_VAR check_globals = 0 header = 0 match_opcode = 324 END

  // abil 0 (level 1): - Stat: Magic Resistance Modifier: -5 (cumulative)
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 166
      multi_match   = 1
  END

  // abil 0 (level 1): + Use EFF File ×7, one per resource below:
  //   Use EFF File ~CDELFCM6~: target RACE HALF_ELF
  //   Use EFF File ~CDELFCM5~: target RACE HALF_ELF
  //   Use EFF File ~CDELFCM4~: target RACE HALF_ELF
  //   Use EFF File ~CDELFCM3~: target RACE HALF_ELF
  //   Use EFF File ~CDELFCM2~: target RACE HALF_ELF
  //   Use EFF File ~CDELFCM1~: target RACE HALF_ELF
  //   Use EFF File ~CDELFCM0~: target RACE HALF_ELF
  SET ip = 0
  PATCH_FOR_EACH v IN ~CDELFCM6~ ~CDELFCM5~ ~CDELFCM4~ ~CDELFCM3~ ~CDELFCM2~ ~CDELFCM1~
      ~CDELFCM0~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 177
        target       = 2
        parameter1   = 3
        parameter2   = 4
        timing       = 0
        probability1 = 30
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Use EFF File ×7, one per resource below:
  //   Use EFF File ~CDELFCM6~: target RACE ELF
  //   Use EFF File ~CDELFCM5~: target RACE ELF
  //   Use EFF File ~CDELFCM4~: target RACE ELF
  //   Use EFF File ~CDELFCM3~: target RACE ELF
  //   Use EFF File ~CDELFCM2~: target RACE ELF
  //   Use EFF File ~CDELFCM1~: target RACE ELF
  //   Use EFF File ~CDELFCM0~: target RACE ELF
  SET ip = 7
  PATCH_FOR_EACH v IN ~CDELFCM6~ ~CDELFCM5~ ~CDELFCM4~ ~CDELFCM3~ ~CDELFCM2~ ~CDELFCM1~
      ~CDELFCM0~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 177
        target       = 2
        parameter1   = 2
        parameter2   = 4
        timing       = 0
        probability1 = 90
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END
  BUT_ONLY

