    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 174
      match_timing  = 4
      multi_match   = 1
      duration      = 90
  END

  // abil 0 (level 1): Stat: Fatigue Modifier: +4 (cumulative)
  LPF ALTER_EFFECT
