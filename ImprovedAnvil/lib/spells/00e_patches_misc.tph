// Hardiness
COPY_EXISTING ~spwish12.spl~ ~override/spwish12.spl~
  // remove the level 4-30 scaling headers (and their effects, every 2 levels)
  FOR (lvl = 4; lvl <= 30; lvl += 2) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): - all 3 Removal: Effects specified by Resource effects:
  //   Removal: Effects specified by Resource ~SPDWD02~ (Defensive Stance)
  //   Removal: Effects specified by Resource ~SPCL907~ (Hardiness)
  //   Removal: Effects specified by Resource ~SPWISH12~ (Hardiness)
  LPF DELETE_EFFECT INT_VAR check_globals = 0 header = 0 match_opcode = 321 END

  // abil 0 (level 1): all 2 Graphics: Play 3D Effect effects — duration = 60
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
