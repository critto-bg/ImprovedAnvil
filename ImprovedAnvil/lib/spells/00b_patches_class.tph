      ~sgrasp19~ ~sgrasp20~ ~shammr3~ ~shammr2~ ~melfmet~ ~critical~ ~slaylive~ ~serious~
      ~harm~ ~sorb~ ~stardart~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 112
        target       = 2
        timing       = 1
        dicesize     = (0 - 1)
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END

