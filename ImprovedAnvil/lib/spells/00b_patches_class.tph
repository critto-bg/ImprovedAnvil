  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 18
      target        = 1
      parameter1    = 20
      timing        = 0
      resist_dispel = 3
      duration      = 30
      dicesize      = 8
      insert_point  = 3
  END

  // abil 0 (level 1): + Protection: from Opcode ×4, one per parameter2 below:
  //   Protection: from Opcode #55 (Death: Kill Creature Type)
  //   Protection: from Opcode #211 (Spell Effect: Imprisonment)
  //   Protection: from Opcode #13 (Death: Instant Death)
  //   Protection: from Opcode #134 (State: Petrification)
  SET ip = 4
  PATCH_FOR_EACH v IN 55 211 13 134
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header        = 1
        opcode        = 101
        target        = 1
        parameter2    = v
        timing        = 0
        resist_dispel = 3
        duration      = 30
        insert_point  = ip
    END
    SET ip += 1
  END

