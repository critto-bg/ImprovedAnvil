  //   Item: Remove Item ~SGRASP20~
  //   Item: Remove Item ~SHAMMR3~
  //   Item: Remove Item ~SHAMMR2~
  //   Item: Remove Item ~MELFMET~
  //   Item: Remove Item ~CRITICAL~
  //   Item: Remove Item ~SLAYLIVE~
  //   Item: Remove Item ~SERIOUS~
  //   Item: Remove Item ~HARM~
  //   Item: Remove Item ~SORB~
  //   Item: Remove Item ~STARDART~
  SET ip = 9
  PATCH_FOR_EACH v IN ~hsword~ ~sgrasp~ ~sgrasp01~ ~sgrasp02~ ~sgrasp03~ ~sgrasp04~
      ~sgrasp05~ ~sgrasp06~ ~sgrasp07~ ~sgrasp08~ ~sgrasp09~ ~sgrasp10~ ~sgrasp11~
