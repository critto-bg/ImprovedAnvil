// spcl221
COPY_EXISTING ~spcl221.spl~ ~override/spcl221.spl~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT9))  // flags: - breaks sanctuary/invisibility

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Protection: from Opcode #5 (Charm: Charm Specific Creature)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 101
      target       = 2
      parameter2   = 5
      timing       = 9
      insert_point = 0
  END

  // abil 0 (level 1): + Use EFF File ×4, one per resource below:
  //   Use EFF File ~DRAGDAM3~: target RACE.IDS #0
  //   Use EFF File ~DRAGHIT~: target RACE.IDS #0
  //   Use EFF File ~DEMHIT3~: target RACE.IDS #0
  //   Use EFF File ~DEMDAM3~: target RACE.IDS #0
  SET ip = 1
  PATCH_FOR_EACH v IN ~dragdam3~ ~draghit~ ~demhit3~ ~demdam3~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 177
        target       = 2
        parameter2   = 4
        timing       = 9
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Protection: from Opcode #25 (State: Poison)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 101
      target       = 2
      parameter2   = 25
      timing       = 9
      insert_point = 5
  END

  // abil 0 (level 1): + Stat: Acid Resistance Modifier: 20 (set)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 27
      target       = 2
      parameter1   = 20
      parameter2   = 1
      timing       = 9
      insert_point = 6
  END

  // abil 0 (level 1): + Stat: Fire Resistance Modifier: 20 (set)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 30
      target       = 2
      parameter1   = 20
      parameter2   = 1
      timing       = 9
      insert_point = 7
  END

  // abil 0 (level 1): + Graphics: Prevent Special Effect Icon ×4, one per parameter2 below:
  //   Graphics: Prevent Special Effect Icon #6 (Poisoned)
  //   Graphics: Prevent Special Effect Icon #0 (Charm)
  //   Graphics: Prevent Special Effect Icon #1 (Dire Charm)
  //   Graphics: Prevent Special Effect Icon #43 (Domination)
  SET ip = 8
  PATCH_FOR_EACH v IN 6 0 1 43
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 169
        target       = 2
        parameter2   = v
        timing       = 9
        insert_point = ip
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Stat: Poison Resistance Modifier (100,0)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 173
      target       = 2
      parameter1   = 100
      timing       = 9
      insert_point = 12
  END

  // abil 0 (level 1): + Script: Scripting State Modifier: SCRIPTINGSTATE1 (IAKITS) := 4 (Cavalier)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 282
      target       = 2
      parameter1   = 4
      timing       = 9
      insert_point = 13
  END

  // abil 0 (level 1): + Spell: Protection from Spell ×10, one per resource below:
  //   Spell: Protection from Spell ~SPIN910~ (Domination)
  //   Spell: Protection from Spell ~SPWI506~ (Domination)
  //   Spell: Protection from Spell ~SPIN985~ (Domination)
  //   Spell: Protection from Spell ~SPIN883~ (Domination)
  //   Spell: Protection from Spell ~SPWI316~ (Dire Charm)
  //   Spell: Protection from Spell ~SPPR982~ (Dire Charm)
  //   Spell: Protection from Spell ~SPPR204~ (Charm Person or Mammal)
  //   Spell: Protection from Spell ~SPWI104~ (Charm Person)
  //   Spell: Protection from Spell ~SPIN980~ (Charm Person)
  //   Spell: Protection from Spell ~SPPR405~ (Mental Domination)
  SET ip = 14
  PATCH_FOR_EACH v IN ~SPIN910~ ~SPWI506~ ~SPIN985~ ~SPIN883~ ~SPWI316~ ~SPPR982~
      ~SPPR204~ ~SPWI104~ ~SPIN980~ ~SPPR405~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 206
        target       = 2
        timing       = 9
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END
  BUT_ONLY

