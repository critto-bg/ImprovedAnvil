// Dispel Magic
COPY_EXISTING ~spcl231.spl~ ~override/spcl231.spl~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT (BIT9 BOR BIT25)))  // flags: - breaks sanctuary/invisibility, castable when silenced
  WRITE_LONG  0x050 (0 - 1)  // unidentified description: (none)

  // remove the level 2-20 scaling headers (and their effects)
  FOR (lvl = 2; lvl <= 20; lvl += 1) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): - Graphics: Remove Special Effect Icon #112 (Deaf)
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 240
      multi_match   = 1
  END

  // abil 0 (level 1): - Cure: Deafness (12,131074)
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 81
      multi_match   = 1
  END

  // abil 0 (level 1): Cure: Dispellable Effects (Dispel Magic) (2,131074)
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 58
      multi_match   = 1
      parameter2    = 2
  END

  // abil 0 (level 1): Use EFF File ~DESTSELF~: target GENDER ILLUSIONARY
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 177
      multi_match   = 1
      resist_dispel = 0
  END

  // abil 0 (level 1): + Item: Remove Item ×5, one per resource below:
  //   Item: Remove Item ~FBLADE~
  //   Item: Remove Item ~SHAMMR~
  //   Item: Remove Item ~SHILLE~
  //   Item: Remove Item ~GHOULT~
  //   Item: Remove Item ~CHILLT~
  SET ip = 3
  PATCH_FOR_EACH v IN ~fblade~ ~shammr~ ~shille~ ~ghoult~ ~chillt~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 112
        target       = 2
        timing       = 1
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END

