/// converted from the pre-edited binary copies (00_copy_vanilla.tph); ///
/// generated by spec/tools/spl_patchgen.py and verified against the   ///
/// shipped binaries, then hand-maintained                             ///

// Aura of Despair
COPY_EXISTING ~spcl103.spl~ ~override/spcl103.spl~
  SAY UNIDENTIFIED_DESC @10316

  // Aura of Despair, Blackguard's special ability
  LPF ~ALTER_SPELL_EFFECT~ INT_VAR
    check_headers = 1
    header_type = 3
    savingthrow = 1
  END
  BUT_ONLY

// spcl151
COPY_EXISTING ~spcl151.spl~ ~override/spcl151.spl~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT9))  // flags: - breaks sanctuary/invisibility

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Stat: Movement Modifier: +2 (cumulative)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 126
      target        = 2
      parameter1    = 2
      timing        = 9
      resist_dispel = 2
      insert_point  = 0
  END

  // abil 0 (level 1): + Script: Scripting State Modifier: SCRIPTINGSTATE1 (IAKITS) := 5 (Barbarian)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 282
      target       = 2
      parameter1   = 5
      timing       = 9
      insert_point = 1
  END
  BUT_ONLY

// Barbarian Rage
