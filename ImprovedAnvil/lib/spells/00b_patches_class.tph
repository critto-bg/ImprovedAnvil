// spcl233b
COPY_EXISTING ~spcl233b.spl~ ~override/spcl233b.spl~
  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Protection: from Opcode ×3, one per parameter2 below:
  //   Protection: from Opcode #5 (Charm: Charm Specific Creature)
  //   Protection: from Opcode #109 (State: Paralyze)
  //   Protection: from Opcode #175 (State: Hold)
  SET ip = 0
  PATCH_FOR_EACH v IN 5 109 175
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header        = 1
        opcode        = 101
        target        = 2
        parameter2    = v
        timing        = 9
        resist_dispel = 2
        insert_point  = ip
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Graphics: Prevent Special Effect Icon ×4, one per parameter2 below:
  //   Graphics: Prevent Special Effect Icon #0 (Charm)
  //   Graphics: Prevent Special Effect Icon #1 (Dire Charm)
  //   Graphics: Prevent Special Effect Icon #13 (Held)
  //   Graphics: Prevent Special Effect Icon #43 (Domination)
  SET ip = 3
  PATCH_FOR_EACH v IN 0 1 13 43
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header        = 1
        opcode        = 169
        target        = 2
        parameter2    = v
        timing        = 9
        resist_dispel = 2
        insert_point  = ip
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Script: Scripting State Modifier: SCRIPTINGSTATE1 (IAKITS) := 3 (Inquisitor)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 282
      target       = 2
      parameter1   = 3
      timing       = 9
      insert_point = 7
  END

  // abil 0 (level 1): + Graphics: Protection from Specific Animation ~SPMINDAT~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 296
      target        = 2
      power         = 4
      timing        = 9
      resist_dispel = 2
      insert_point  = 8
    STR_VAR
      resource      = ~SPMINDAT~
  END

  // abil 0 (level 1): + Spell: Protection from Spell ×10, one per resource below:
  //   Spell: Protection from Spell ~SPIN910~ (Domination)
  //   Spell: Protection from Spell ~SPIN883~ (Domination)
  //   Spell: Protection from Spell ~SPIN985~ (Domination)
  //   Spell: Protection from Spell ~SPIN980~ (Charm Person)
  //   Spell: Protection from Spell ~SPWI104~ (Charm Person)
  //   Spell: Protection from Spell ~SPWI316~ (Dire Charm)
  //   Spell: Protection from Spell ~SPWI506~ (Domination)
  //   Spell: Protection from Spell ~SPPR405~ (Mental Domination)
  //   Spell: Protection from Spell ~SPPR204~ (Charm Person or Mammal)
  //   Spell: Protection from Spell ~SPPR982~ (Dire Charm)
  SET ip = 9
  PATCH_FOR_EACH v IN ~SPIN910~ ~SPIN883~ ~SPIN985~ ~SPIN980~ ~SPWI104~ ~SPWI316~
      ~SPWI506~ ~SPPR405~ ~SPPR204~ ~SPPR982~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 206
        target       = 2
        timing       = 9
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END
  BUT_ONLY

