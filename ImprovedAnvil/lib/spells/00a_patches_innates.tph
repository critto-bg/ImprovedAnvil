// Anti-Magic Ray
COPY_EXISTING ~spin550.spl~ ~override/spin550.spl~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT9))  // flags: - breaks sanctuary/invisibility
  WRITE_BYTE  0x025 0  // primary type: None
  WRITE_BYTE  0x027 0  // secondary type: NONE

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Cure: Dispellable Effects (Dispel Magic)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 58
      target       = 2
      timing       = 1
      insert_point = 0
  END

  // abil 0 (level 1): + Removal: Remove Secondary Type ×6, one per parameter2 below:
  //   Removal: Remove Secondary Type: SPELLPROTECTIONS (max level 9)
  //   Removal: Remove Secondary Type: SPECIFICPROTECTIONS (max level 9)
  //   Removal: Remove Secondary Type: ILLUSIONARYPROTECTIONS (max level 9)
  //   Removal: Remove Secondary Type: CONJURATION (max level 9)
  //   Removal: Remove Secondary Type: COMBATPROTECTIONS (max level 9)
  //   Removal: Remove Secondary Type: COMBINATION (max level 9)
  SET ip = 1
  PATCH_FOR_EACH v IN 1 2 3 6 7 12
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 221
        target       = 2
        parameter1   = 9
        parameter2   = v
        timing       = 1
        insert_point = ip
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Graphics: Lighting Effects (0,12)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 141
      target       = 2
      parameter2   = 12
      timing       = 1
      insert_point = 7
  END

  // abil 0 (level 1): + Text: Display String: "Dispel Effects"
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 139
      target       = 2
      parameter1   = 14056
      timing       = 1
      insert_point = 8
  END

  // abil 0 (level 1): + Graphics: Play 3D Effect ~SPDISPMA~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 215
      target       = 2
      timing       = 0
      duration     = 5
      insert_point = 9
    STR_VAR
      resource     = ~SPDISPMA~
  END

  // abil 0 (level 1): + Stat: Miscast Magic (100,0)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 60
      target       = 2
      parameter1   = 100
      timing       = 0
      duration     = 30
      insert_point = 10
  END

  // abil 0 (level 1): + Stat: Miscast Magic (0,1)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 60
      target       = 2
      parameter2   = 1
      timing       = 0
      duration     = 30
      insert_point = 11
  END

  // abil 0 (level 1): + Stat: Miscast Magic (100,2)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 60
      target       = 2
      parameter1   = 100
      parameter2   = 2
      timing       = 0
      duration     = 30
      insert_point = 12
  END

  // abil 0 (level 1): + Graphics: Remove Special Effect Icon #28 (Protection From Magic)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 240
      target       = 2
      parameter2   = 28
      timing       = 1
      insert_point = 13
  END

  // abil 0 (level 1): + Spell: Drain Wizard Spell (1,0)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 244
      target       = 2
      parameter1   = 1
      timing       = 1
      insert_point = 14
  END

  // abil 0 (level 1): + Item: Drain Item Charges (5,0)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 243
      target       = 2
      parameter1   = 5
      timing       = 9
      insert_point = 15
  END

  // abil 0 (level 1): + Item: Remove Item ×6, one per resource below:
  //   Item: Remove Item ~MELFMET~
  //   Item: Remove Item ~CRITICAL~
  //   Item: Remove Item ~SLAYLIVE~
  //   Item: Remove Item ~SERIOUS~
  //   Item: Remove Item ~HARM~
  //   Item: Remove Item ~SORB~
  SET ip = 16
  PATCH_FOR_EACH v IN ~MELFMET~ ~CRITICAL~ ~SLAYLIVE~ ~SERIOUS~ ~HARM~ ~SORB~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 112
        target       = 2
        timing       = 1
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END
  BUT_ONLY

