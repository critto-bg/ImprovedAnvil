  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 215
      target       = 2
      parameter2   = 1
      timing       = 0
      duration     = 1
      insert_point = 3
    STR_VAR
      resource     = ~SPROTECT~
  END

  // abil 0 (level 1): + Protection: from Opcode ×3, one per parameter2 below:
  //   Protection: from Opcode #5 (Charm: Charm Specific Creature)
  //   Protection: from Opcode #128 (State: Confusion)
  //   Protection: from Opcode #24 (State: Horror)
  SET ip = 4
  PATCH_FOR_EACH v IN 5 128 24
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 101
        target       = 2
        parameter2   = v
        timing       = 0
        duration     = 4800
        insert_point = ip
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Graphics: Prevent Special Effect Icon ×4, one per parameter2 below:
  //   Graphics: Prevent Special Effect Icon #0 (Charm)
  //   Graphics: Prevent Special Effect Icon #3 (Confused)
  //   Graphics: Prevent Special Effect Icon #43 (Domination)
  //   Graphics: Prevent Special Effect Icon #1 (Dire Charm)
  SET ip = 7
  PATCH_FOR_EACH v IN 0 3 43 1
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 169
        target       = 2
        parameter2   = v
        timing       = 0
        duration     = 4800
        insert_point = ip
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Graphics: Protection from Specific Animation ~SPCONFUS~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 296
      target       = 2
      timing       = 0
      duration     = 4800
      insert_point = 11
    STR_VAR
      resource     = ~SPCONFUS~
  END
  BUT_ONLY

