// Lay On Hands
COPY_EXISTING ~spin827.spl~ ~override/spin827.spl~
  SAY UNIDENTIFIED_DESC @10363
  WRITE_ASCII 0x03a ~SPPR103C~ #8  // spellbook icon

  // remove the level 5-20 scaling headers (and their effects)
  FOR (lvl = 5; lvl <= 20; lvl += 1) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): header fields — target type=1, icon
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header = 1
      target = 1
    STR_VAR
      icon   = ~SPCL815~
  END

  // abil 1 (level 2): header fields — target type=1, level required=9, icon
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header    = 2
      target    = 1
      min_level = 9
    STR_VAR
      icon      = ~SPCL815~
  END

  // abil 2 (level 3): header fields — target type=1, level required=13, icon
