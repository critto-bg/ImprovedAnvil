  //   Item: Remove Item ~SERIOUS~
  //   Item: Remove Item ~HARM~
  //   Item: Remove Item ~SORB~
  //   Item: Remove Item ~STARDART~
  SET ip = 36
  PATCH_FOR_EACH v IN ~SGRASP17~ ~SGRASP18~ ~SGRASP19~ ~SGRASP20~ ~SHAMMR3~ ~SHAMMR2~
      ~MELFMET~ ~CRITICAL~ ~SLAYLIVE~ ~SERIOUS~ ~HARM~ ~SORB~ ~STARDART~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 112
        target       = 2
        timing       = 1
        insert_point = ip
      STR_VAR
        resource     = EVAL ~%v%~
    END
    SET ip += 1
  END
  BUT_ONLY

