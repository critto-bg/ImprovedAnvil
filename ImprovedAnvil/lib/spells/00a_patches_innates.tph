  // abil 0 (level 1): + Removal: Remove Secondary Type ×6, one per parameter2 below:
  //   Removal: Remove Secondary Type: SPELLPROTECTIONS (max level 9)
  //   Removal: Remove Secondary Type: SPECIFICPROTECTIONS (max level 9)
  //   Removal: Remove Secondary Type: ILLUSIONARYPROTECTIONS (max level 9)
  //   Removal: Remove Secondary Type: CONJURATION (max level 9)
  //   Removal: Remove Secondary Type: COMBATPROTECTIONS (max level 9)
  //   Removal: Remove Secondary Type: COMBINATION (max level 9)
  SET ip = 1
  PATCH_FOR_EACH v IN 1 2 3 6 7 12
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 221
        target       = 2
        parameter1   = 9
        parameter2   = v
        timing       = 1
        insert_point = ip
    END
    SET ip += 1
  END

