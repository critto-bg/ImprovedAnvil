/// vanilla spell patches: SPIN — shared innate abilities ///
/// converted from the pre-edited binary copies (00_copy_vanilla.tph); ///
/// generated by spec/tools/spl_patchgen.py and verified against the   ///
/// shipped binaries, then hand-maintained                             ///

// Draw Upon Holy Might
COPY_EXISTING ~spin103.spl~ ~override/spin103.spl~
  SAY UNIDENTIFIED_DESC @384

  // every header: casting time=5
  LPF ALTER_SPELL_HEADER
    INT_VAR
      speed = 5
  END

  // every header: - all 6 Script: Scripting State Modifier effects:
  //   Script: Scripting State Modifier: SCRIPTINGSTATE6 (WEAPONIMMUNITY) := 4 (Absolute Immunity)  ×6
  LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 282 END
  BUT_ONLY

// Larloch's Minor Drain
COPY_EXISTING ~spin104.spl~ ~override/spin104.spl~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT (BIT9 BOR BIT25)))  // flags: - breaks sanctuary/invisibility, castable when silenced
  READ_LONG   0x01e "exclusion"
  WRITE_LONG  0x01e ("%exclusion%" BOR (BIT10 BOR BIT13))  // exclusion flags: + Illusionists, Transmuters

  // abil 0 (level 1): header fields — range=30, casting time=0
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header = 1
      range  = 30
      speed  = 0
  END

  // casting fx: + HP: Maximum HP Modifier: +4 (cumulative)
  LPF ADD_SPELL_CFEFFECT
    INT_VAR
      opcode        = 18
      target        = 1
      power         = 1
      parameter1    = 4
      timing        = 0
      resist_dispel = 1
      duration      = 60
      dicesize      = 3
      insert_point  = 0
  END

  // casting fx: + HP: Current HP Modifier: +4 (cumulative)
  LPF ADD_SPELL_CFEFFECT
    INT_VAR
      opcode        = 17
      target        = 1
      power         = 1
      parameter1    = 4
      timing        = 1
      resist_dispel = 1
      dicesize      = 6
      insert_point  = 1
  END

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + HP: Damage: 4 magic
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 12
      target        = 2
      power         = 1
      parameter1    = 4
      parameter2    = 4194304
      timing        = 1
      resist_dispel = 3
      dicesize      = 4
      insert_point  = 0
  END

  // abil 0 (level 1): + Graphics: Lighting Effects (0,2)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 141
      target        = 2
      parameter2    = 2
      timing        = 1
      resist_dispel = 3
      insert_point  = 1
  END

  // abil 0 (level 1): + Spell Effect: Play Sound Effect ~EFF_M07~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 174
      target        = 2
      power         = 1
      timing        = 1
      resist_dispel = 3
      duration      = 60
      insert_point  = 2
    STR_VAR
      resource      = ~EFF_M07~
  END

  // abil 0 (level 1): + HP: Maximum HP Modifier: +4 (cumulative)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 18
      target        = 1
      power         = 1
      parameter1    = 4
      timing        = 0
      resist_dispel = 3
      duration      = 60
      dicesize      = 4
      insert_point  = 3
  END

  // abil 0 (level 1): + Spell Effect: Play Sound Effect ~EFF_E04~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 174
      target        = 1
      power         = 1
      timing        = 4
      resist_dispel = 3
      duration      = 60
      insert_point  = 4
    STR_VAR
      resource      = ~EFF_E04~
  END
  BUT_ONLY

// Vampiric Touch
COPY_EXISTING ~spin106.spl~ ~override/spin106.spl~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT9))  // flags: - breaks sanctuary/invisibility
  READ_LONG   0x01e "exclusion"
  WRITE_LONG  0x01e ("%exclusion%" BOR (BIT10 BOR BIT13))  // exclusion flags: + Illusionists, Transmuters

  // remove the level 6-12 scaling headers (and their effects, every 2 levels)
  FOR (lvl = 6; lvl <= 12; lvl += 2) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + HP: Damage: 0 magic
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 12
      target        = 2
      power         = 3
      parameter2    = 4194304
      timing        = 1
      resist_dispel = 3
      dicenumber    = 2
      dicesize      = 6
      insert_point  = 0
  END

  // abil 0 (level 1): + HP: Maximum HP Modifier: +4 (cumulative)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 18
      target        = 1
      power         = 3
      parameter1    = 4
      timing        = 0
      resist_dispel = 3
      duration      = 300
      dicesize      = 6
      insert_point  = 1
  END

  // abil 0 (level 1): + Graphics: Lighting Effects (0,2)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 141
      target        = 2
      power         = 3
      parameter2    = 2
      timing        = 1
      resist_dispel = 3
      insert_point  = 2
  END

  // abil 0 (level 1): + Spell Effect: Play Sound Effect ~EFF_M07~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 174
      target        = 2
      power         = 3
      timing        = 1
      resist_dispel = 3
      insert_point  = 3
    STR_VAR
      resource      = ~EFF_M07~
  END

  // abil 0 (level 1): + Graphics: Play 3D Effect ~SPHANDAT~ (0,1)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 215
      target        = 2
      power         = 3
      parameter2    = 1
      timing        = 0
      resist_dispel = 3
      duration      = 2
      insert_point  = 4
    STR_VAR
      resource      = ~SPHANDAT~
  END

  // abil 0 (level 1): + Graphics: Play 3D Effect ~SPHEALIN~ (0,1)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 215
      target        = 1
      power         = 3
      parameter2    = 1
      timing        = 0
      resist_dispel = 3
      duration      = 3
      insert_point  = 5
    STR_VAR
      resource      = ~SPHEALIN~
  END

  // abil 1: clone of abil 0 for level 6
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 2 min_level = 6 END
  WRITE_LONG  0x1fe 3  // abil 1 fx 0 (HP: Damage): dicenumber
  WRITE_LONG  0x216 6  // abil 1 fx 1 (HP: Maximum HP Modifier): parameter1

  // abil 2: clone of abil 0 for level 8
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 3 min_level = 8 END
  WRITE_LONG  0x346 4  // abil 2 fx 0 (HP: Damage): dicenumber
  WRITE_LONG  0x35e 8  // abil 2 fx 1 (HP: Maximum HP Modifier): parameter1

  // abil 3: clone of abil 0 for level 10
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 4 min_level = 10 END
  WRITE_LONG  0x48e  5  // abil 3 fx 0 (HP: Damage): dicenumber
  WRITE_LONG  0x4a6 10  // abil 3 fx 1 (HP: Maximum HP Modifier): parameter1

  // abil 4: clone of abil 0 for level 12
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 5 min_level = 12 END
  WRITE_LONG  0x5d6  6  // abil 4 fx 0 (HP: Damage): dicenumber
  WRITE_LONG  0x5ee 12  // abil 4 fx 1 (HP: Maximum HP Modifier): parameter1
  BUT_ONLY

