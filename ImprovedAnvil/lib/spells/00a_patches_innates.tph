  //   Removal: Effects specified by Resource ~GHOULLOR~
  //   Removal: Effects specified by Resource ~IOTYUGH~
  //   Removal: Effects specified by Resource ~LACEDO~
  //   Removal: Effects specified by Resource ~LACEDO02~
  //   Removal: Effects specified by Resource ~MAGISPWR~
  //   Removal: Effects specified by Resource ~MISC8J~
  //   Removal: Effects specified by Resource ~MUMGREW~
  //   Removal: Effects specified by Resource ~MUMMYW~
  //   Removal: Effects specified by Resource ~OHHGMUM1~
  //   Removal: Effects specified by Resource ~OHRSLNG1~
  //   Removal: Effects specified by Resource ~OTYUGH~
  //   Removal: Effects specified by Resource ~P1-2P~
  //   Removal: Effects specified by Resource ~PARAGHAS~
  //   Removal: Effects specified by Resource ~PUDDEN01~
  //   Removal: Effects specified by Resource ~SAHZOM01~
  //   Removal: Effects specified by Resource ~SHARSWD~
  //   Removal: Effects specified by Resource ~SPIDWR1~
  //   Removal: Effects specified by Resource ~ZOMSEA~
  //   Removal: Effects specified by Resource ~OHBCDIS~ (Cause Disease)
  //   Removal: Effects specified by Resource ~OHDMASK~ (Breathe Acid)
  //   Removal: Effects specified by Resource ~OHRGROG~
  //   Removal: Effects specified by Resource ~SPIN784~ (Snake Gaze)
  //   Removal: Effects specified by Resource ~S!MISVA1~
  //   Removal: Effects specified by Resource ~SPWI409~ (Contagion)
  SET ip = 4
  PATCH_FOR_EACH v IN ~ACIDOOZ3~ ~DARTMEL~ ~DEMOGORG~ ~GHAST1~ ~GHOULLOR~ ~IOTYUGH~
      ~LACEDO~ ~LACEDO02~ ~MAGISPWR~ ~MISC8J~ ~MUMGREW~ ~MUMMYW~ ~OHHGMUM1~ ~OHRSLNG1~
      ~OTYUGH~ ~P1-2P~ ~PARAGHAS~ ~PUDDEN01~ ~SAHZOM01~ ~SHARSWD~ ~SPIDWR1~ ~ZOMSEA~
      ~OHBCDIS~ ~OHDMASK~ ~OHRGROG~ ~SPIN784~ ~S!MISVA1~ ~SPWI409~
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header        = 4
        opcode        = 321
        target        = 2
        power         = 4
        timing        = 0
        resist_dispel = 3
        insert_point  = ip
      STR_VAR
        resource      = EVAL ~%v%~
    END
    SET ip += 1
  END

