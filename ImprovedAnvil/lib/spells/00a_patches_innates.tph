// Strength
COPY_EXISTING ~spin826.spl~ ~override/spin826.spl~
  SAY NAME1    @10259
  SAY UNIDENTIFIED_DESC @10260
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BOR (BIT15 BOR BIT25))  // flags: + ignore wild surge, castable when silenced
  WRITE_BYTE  0x025             0  // primary type: None
  WRITE_BYTE  0x027             0  // secondary type: NONE
  WRITE_ASCII 0x03a ~SPPRI27C~ #8  // spellbook icon

  // remove the level 7 header (and its effects)
  LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = 7 END

  // remove the level 13 header (and its effects)
  LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = 13 END
  WRITE_SHORT 0x096 0  // abil 0: charge depletion

