  WRITE_LONG  0xe3e 3  // abil 2 fx 19 (Stat: Save vs. Wands Modifier): parameter1
  WRITE_LONG  0xe6e 3  // abil 2 fx 20 (Stat: Save vs. Petrification/Polymorph Modifier): parameter1
  WRITE_LONG  0xe9e 3  // abil 2 fx 21 (Stat: Save vs. Breath Weapons Modifier): parameter1
  WRITE_LONG  0xece 3  // abil 2 fx 22 (Stat: Save vs. Spells Modifier): parameter1
  WRITE_LONG  0xefe 3  // abil 2 fx 23 (Stat: To Hit Modifier): parameter1

  // set all opcode to be undispellable
  LAUNCH_PATCH_FUNCTION ~ALTER_SPELL_EFFECT~ INT_VAR
    check_headers = 1
    resist_dispel = 0
  END
  BUT_ONLY

