    INT_VAR
      header       = 1
      opcode       = 142
      target       = 2
      parameter2   = 105
      timing       = 0
      duration     = 20
      insert_point = 18
  END

  // abil 0 (level 1): + Item: Remove Item ×13, one per resource below:
  //   Item: Remove Item ~SGRASP17~
  //   Item: Remove Item ~SGRASP18~
  //   Item: Remove Item ~SGRASP19~
  //   Item: Remove Item ~SGRASP20~
