// Melf's Acid Arrow
COPY_EXISTING ~spwi211.spl~ ~override/spwi211.spl~
  SAY UNIDENTIFIED_DESC @10161
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT9))  // flags: - breaks sanctuary/invisibility

  // remove the level 6-21 scaling headers (and their effects, every 3 levels)
  FOR (lvl = 6; lvl <= 21; lvl += 3) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): header fields — spell form=2
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header          = 1
      new_header_type = 2
  END

  // abil 0 (level 1): - HP: Damage: 0 acid
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 12
      match_timing  = 4
      multi_match   = 1
  END

  // abil 0 (level 1): - Graphics: Display Special Effect Icon #102 (Acid)
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 142
      multi_match   = 1
  END

  // abil 0 (level 1): HP: Damage: 0 acid
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 12
      multi_match   = 1
      parameter1    = 2
  END

  // abil 1: clone of abil 0 for level 6
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 2 min_level = 6 END
  WRITE_BYTE  0x09a 1  // abil 1: spell form
  WRITE_LONG  0x126 4  // abil 1 fx 0 (HP: Damage): parameter1

  // abil 2: clone of abil 0 for level 9
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 3 min_level = 9 END
  WRITE_BYTE  0x0c2 1  // abil 2: spell form
  WRITE_LONG  0x1ae 6  // abil 2 fx 0 (HP: Damage): parameter1

  // abil 3: clone of abil 0 for level 12
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 4 min_level = 12 END
  WRITE_BYTE  0x0ea 1  // abil 3: spell form
  WRITE_LONG  0x236 8  // abil 3 fx 0 (HP: Damage): parameter1

  // abil 4: clone of abil 0 for level 15
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 5 min_level = 15 END
  WRITE_BYTE  0x112  1  // abil 4: spell form
  WRITE_LONG  0x2be 10  // abil 4 fx 0 (HP: Damage): parameter1

  // abil 5: clone of abil 0 for level 18
  LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = 6 min_level = 18 END
  WRITE_BYTE  0x13a  1  // abil 5: spell form
  WRITE_LONG  0x346 12  // abil 5 fx 0 (HP: Damage): parameter1
  BUT_ONLY

