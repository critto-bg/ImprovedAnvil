  WRITE_LONG  0x01e (("%exclusion%" BOR BIT10) BAND (BNOT BIT8))  // exclusion flags: + Illusionists; - Diviners
  WRITE_SHORT 0x022            9  // casting graphics
  WRITE_BYTE  0x025            7  // primary type: Necromancer
  WRITE_BYTE  0x027           13  // secondary type: NON-COMBAT

  // abil 0 (level 1): header fields — target type=5, range=1, casting time=4
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header = 1
      target = 5
      range  = 1
      speed  = 4
  END

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Removal: Remove Secondary Type: ILLUSIONARYPROTECTIONS (max level 9)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 221
      target       = 3
      parameter1   = 9
      parameter2   = 3
      timing       = 1
      insert_point = 0
  END

  // abil 0 (level 1): + Cure: Invisibility
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 47
      target       = 3
      timing       = 1
      insert_point = 1
  END

  // abil 0 (level 1): + Summon: Creature Summoning ~S!SPY4~ (0,3)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 67
      target       = 1
      parameter2   = 3
      timing       = 0
      duration     = 60
      insert_point = 2
    STR_VAR
      resource     = ~S!SPY4~
  END
  BUT_ONLY

