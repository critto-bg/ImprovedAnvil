// Mislead
COPY_EXISTING ~spwi607.spl~ ~override/spwi607.spl~
  SAY NAME1    @9107
  SAY UNIDENTIFIED_DESC @9108
  WRITE_ASCII 0x010 ~CAS_M08~ #8  // completion sound
  READ_LONG   0x01e "exclusion"
  WRITE_LONG  0x01e (("%exclusion%" BOR BIT6) BAND (BNOT BIT12))  // exclusion flags: + Abjurers; - Necromancers
  WRITE_SHORT 0x022           10  // casting graphics
  WRITE_BYTE  0x025            8  // primary type: Transmuter
  WRITE_BYTE  0x027           13  // secondary type: NON-COMBAT

  // remove the level 13-20 scaling headers (and their effects)
  FOR (lvl = 13; lvl <= 20; lvl += 1) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): header fields — target type=1, casting time=6
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header = 1
      target = 1
      speed  = 6
  END

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Stat: Strength Modifier: 20 (set)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 44
      target       = 2
      power        = 6
      parameter1   = 20
      parameter2   = 1
      timing       = 0
      duration     = 120
      insert_point = 0
  END

  // abil 0 (level 1): + Colour: Glow by RGB (Brief) (1614807040,1966080)
