      insert_point  = 6
  END

  // abil 0 (level 1): + Spell: Protection from Spell ~SPWI803~ (Protection From Energy)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 206
      target        = 2
      timing        = 0
      resist_dispel = 3
      duration      = 96
      insert_point  = 13
    STR_VAR
      resource      = ~SPWI803~
  END

  // abil 1-4: clone abil 0 for levels 17-20, per-level scaling:
  //   Stat: Cold Resistance Modifier: duration = (level * 6)
  //   Spell Effect: Play Sound Effect: duration = (level * 6)
  //   Stat: Electricity Resistance Modifier: duration = (level * 6)
  //   Stat: Fire Resistance Modifier: duration = (level * 6)
  //   Script: Scripting State Modifier: duration = (level * 6)
  //   Stat: Magical Fire Resistance Modifier: duration = (level * 6)
  //   Stat: Magical Cold Resistance Modifier: duration = (level * 6)
  //   Stat: Magic Damage Resistance Modifier: duration = (level * 6)
  //   Stat: Acid Resistance Modifier: duration = (level * 6)
  //   Graphics: Display Special Effect Icon: duration = (level * 6)
  //   Graphics: Play 3D Effect: power = 7
  //   Spell: Protection from Spell: duration = (level * 6)
  SET pos = 2
  FOR (lvl = 17; lvl <= 20; lvl += 1) BEGIN
    LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = pos min_level = lvl END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 28 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 174 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 29 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 30 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 282 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 84 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 85 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 31 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 27 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 142 duration = (lvl * 6) END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 215 power = 7 END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos match_opcode = 206 duration = (lvl * 6) END
    SET pos += 1
  END
  BUT_ONLY

