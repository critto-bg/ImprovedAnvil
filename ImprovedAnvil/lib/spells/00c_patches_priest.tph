// Silence, 15' Radius
COPY_EXISTING ~sppr211.spl~ ~override/sppr211.spl~
  SAY UNIDENTIFIED_DESC @9538
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT9))  // flags: - breaks sanctuary/invisibility

  // remove the level 2-20 scaling headers (and their effects)
  FOR (lvl = 2; lvl <= 20; lvl += 1) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 1-5: clone abil 0 for levels 6-18 (every 3), durations scaled to (level * 4)
  SET pos = 2
  FOR (lvl = 6; lvl <= 18; lvl += 3) BEGIN
    LPF ~S!CLONE_SPELL_HEADER~ INT_VAR header = 1 position = pos min_level = lvl END
    LPF ALTER_SPELL_EFFECT INT_VAR header = pos duration_high = (lvl * 4) END
    SET pos += 1
  END
  BUT_ONLY

