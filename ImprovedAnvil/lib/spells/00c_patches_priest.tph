// Chaotic Commands
COPY_EXISTING ~sppr508.spl~ ~override/sppr508.spl~
  SAY UNIDENTIFIED_DESC @9051

  // remove the level 10-18 scaling headers (and their effects)
  FOR (lvl = 10; lvl <= 18; lvl += 1) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Colour: Glow by RGB (Brief) (6127104,1966080)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 50
      target        = 2
      power         = 5
      parameter1    = 6127104
      parameter2    = 1966080
      timing        = 0
      resist_dispel = 2
      duration      = 2
      insert_point  = 0
  END

  // abil 0 (level 1): + Spell Effect: Play Sound Effect ~EFF_E04~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 174
      target        = 2
      power         = 5
      timing        = 4
      resist_dispel = 3
      duration      = 60
      insert_point  = 1
    STR_VAR
      resource      = ~EFF_E04~
  END

  // abil 0 (level 1): + Protection: from Opcode ×4, one per parameter2 below:
  //   Protection: from Opcode #5 (Charm: Charm Specific Creature)
  //   Protection: from Opcode #76 (State: Feeblemindedness)
  //   Protection: from Opcode #128 (State: Confusion)
  //   Protection: from Opcode #3 (State: Berserking)
  SET ip = 2
  PATCH_FOR_EACH v IN 5 76 128 3
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header        = 1
        opcode        = 101
        target        = 2
        power         = 5
        parameter2    = v
        timing        = 0
        resist_dispel = 3
        duration      = 60
        insert_point  = ip
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Graphics: Prevent Special Effect Icon ×7, one per parameter2 below:
  //   Graphics: Prevent Special Effect Icon #4 (Berserk)
  //   Graphics: Prevent Special Effect Icon #0 (Charm)
  //   Graphics: Prevent Special Effect Icon #1 (Dire Charm)
  //   Graphics: Prevent Special Effect Icon #2 (Rigid Thinking)
  //   Graphics: Prevent Special Effect Icon #3 (Confused)
  //   Graphics: Prevent Special Effect Icon #47 (Chaos)
  //   Graphics: Prevent Special Effect Icon #14 (Sleep)
  SET ip = 6
  PATCH_FOR_EACH v IN 4 0 1 2 3 47 14
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header        = 1
        opcode        = 169
        target        = 2
        power         = 5
        parameter2    = v
        timing        = 0
        resist_dispel = 3
        duration      = 60
        insert_point  = ip
    END
    SET ip += 1
  END

  // abil 0 (level 1): + Protection: from Opcode #128 (State: Confusion)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 101
      target        = 2
      power         = 5
      parameter2    = 128
      timing        = 0
      resist_dispel = 3
      duration      = 60
      insert_point  = 13
  END

  // abil 0 (level 1): + Protection: from Opcode #39 (State: Unconsciousness)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 101
      target        = 2
      power         = 5
      parameter2    = 39
      timing        = 0
      resist_dispel = 3
      duration      = 60
      insert_point  = 14
  END

  // abil 0 (level 1): + Graphics: Display Special Effect Icon #134 (Chaotic Commands)
