  // abil 0 (level 1): + Item: Set Melee Effect ~S!FIRDAM~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 248
      target        = 1
      power         = 2
      timing        = 0
      resist_dispel = 1
      duration      = 60
      insert_point  = 0
