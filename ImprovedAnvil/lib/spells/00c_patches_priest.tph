  LPF ALTER_SPELL_EFFECT INT_VAR
    check_headers = 1
    match_opcode = 44
    new_opcode = 278
  END

  // change displayed string on THAC0 drain
  LPF ALTER_SPELL_EFFECT INT_VAR
    check_headers = 1
    match_opcode = 139
    parameter1 = 8320
  END
  BUT_ONLY

