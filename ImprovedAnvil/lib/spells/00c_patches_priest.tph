// Flame Blade
COPY_EXISTING ~sppr206.spl~ ~override/sppr206.spl~
  SAY UNIDENTIFIED_DESC @11146

  // remove the level 2-20 scaling headers (and their effects, every 2 levels)
  FOR (lvl = 2; lvl <= 20; lvl += 2) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END
  WRITE_SHORT 0x096 0  // abil 0: charge depletion

  // abil 0 (level 1): header fields — dice sides=0, damage type=0, charges=0
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header      = 1
      dicesize    = 0
      damage_type = 0
      charges     = 0
  END

  // abil 0 (level 1): - Item: Create Magical Weapon ~FBLADE~ (Flame Blade)
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 111
      multi_match   = 1
