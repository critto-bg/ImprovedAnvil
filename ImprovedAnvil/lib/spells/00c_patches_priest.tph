COPY_EXISTING ~sppr729.spl~ ~override/sppr729.spl~
  SAY NAME1    @9105
  SAY UNIDENTIFIED_DESC @9565
  WRITE_ASCII 0x010  ~CAS_M02~ #8  // completion sound
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT (BIT9 BOR BIT14)))  // flags: - breaks sanctuary/invisibility, ignore dead magic/wild surge
  WRITE_SHORT 0x022            16  // casting graphics
  WRITE_BYTE  0x025             3  // primary type: Diviner
  WRITE_ASCII 0x03a ~SPWI807C~ #8  // spellbook icon

  // remove the level 2-20 scaling headers (and their effects)
  FOR (lvl = 2; lvl <= 20; lvl += 1) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): header fields — range=1, casting time=8, icon
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header = 1
      range  = 1
      speed  = 8
    STR_VAR
      icon   = ~SPWI807B~
  END

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Colour: Glow Pulse ×6, one per parameter2 below:
  //   Colour: Glow Pulse: avatar hair, speed 20 (RGB 0x5D6F0000)
