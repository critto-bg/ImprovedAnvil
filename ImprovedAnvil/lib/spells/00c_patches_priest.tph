  //   Colour: Glow Pulse: avatar major, speed 20 (RGB 0x5D6F0000)
  //   Colour: Glow Pulse: avatar minor, speed 20 (RGB 0x5D6F0000)
  SET ip = 0
  PATCH_FOR_EACH v IN 1310726 1310723 1310724 1310720 1310722 1310721
  BEGIN
    LPF ADD_SPELL_EFFECT
      INT_VAR
        header       = 1
        opcode       = 9
        target       = 1
        power        = 7
        parameter1   = 1567555584
        parameter2   = v
        timing       = 0
        duration     = 60
        insert_point = ip
    END
    SET ip += 1
  END

