  // abil 0 (level 1): + Graphics: Display Special Effect Icon #212 (Flame Blade)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 142
      target        = 1
      power         = 2
      parameter2    = 212
      timing        = 0
      resist_dispel = 1
      duration      = 60
      insert_point  = 1
    STR_VAR
      resource      = ~S!FIRDAM~
  END

  // abil 0 (level 1): + State: Set Extended or Spell State ~S!FIRDAM~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 328
      target        = 1
      power         = 2
      timing        = 0
      resist_dispel = 1
      duration      = 60
      special       = 1
      insert_point  = 2
    STR_VAR
      resource      = ~S!FIRDAM~
  END

  // abil 0 (level 1): + Spell: Protection from Spell ~SPPR206~ (Flame Blade)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 206
      target        = 1
      power         = 2
      timing        = 0
      resist_dispel = 1
      duration      = 60
      insert_point  = 4
    STR_VAR
      resource      = ~SPPR206~
  END

  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      check_headers = 1
      match_opcode = 328
      parameter2 = ~%flame_blade_state%~
  END
  BUT_ONLY

