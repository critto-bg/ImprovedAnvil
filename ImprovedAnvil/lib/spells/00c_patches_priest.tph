  WRITE_BYTE  0x025             7  // primary type: Necromancer
  WRITE_BYTE  0x027            12  // secondary type: COMBINATION
  WRITE_ASCII 0x03a ~SPWI424C~ #8  // spellbook icon

  // remove the level 2-20 scaling headers (and their effects)
  FOR (lvl = 2; lvl <= 20; lvl += 1) BEGIN
    LPF DELETE_SPELL_HEADER INT_VAR header_type = (0 - 1) min_level = lvl END
  END

  // abil 0 (level 1): header fields — spell form=2, target type=1, range=50, casting time=5, projectile=209, icon
  LPF ALTER_SPELL_HEADER
    INT_VAR
      header          = 1
      new_header_type = 2
      target          = 1
      range           = 50
      speed           = 5
      projectile      = 209
    STR_VAR
      icon            = ~SPWI424B~
  END

  // abil 0 (level 1): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (level 1): + Use EFF File ~S!DISRU3~: target GENERAL UNDEAD
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 177
      target       = 2
      power        = 4
      parameter1   = 4
      parameter2   = 3
      timing       = 1
      insert_point = 0
    STR_VAR
      resource     = ~S!DISRU3~
  END

  // abil 0 (level 1): + Use EFF File ~S!DISRU2~: target GENERAL UNDEAD
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header       = 1
      opcode       = 177
      target       = 2
      power        = 4
      parameter1   = 4
      parameter2   = 3
      timing       = 1
      insert_point = 1
    STR_VAR
      resource     = ~S!DISRU2~
  END
  BUT_ONLY

