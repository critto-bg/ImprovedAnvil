// Bless
COPY_EXISTING ~sppr101.spl~ ~override/sppr101.spl~
  // abil 0 (level 1): + State: Set Extended or Spell State (1,22)
  LPF ADD_SPELL_EFFECT
    INT_VAR
      header        = 1
      opcode        = 328
      target        = 2
      power         = 1
      parameter1    = 1
      parameter2    = 22
      timing        = 0
      resist_dispel = 3
      duration      = 36
      special       = 1
      insert_point  = 0
  END
  BUT_ONLY

// Entangle
COPY_EXISTING ~sppr105.spl~ ~override/sppr105.spl~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT9))  // flags: - breaks sanctuary/invisibility

  // abil 0 (level 1): Spell Effect: Play Sound Effect ~EFF_M22A~
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 174
      match_timing  = 4
      multi_match   = 1
      power         = 2
  END
  BUT_ONLY

