/// Patch existing (stock) effect files ///

// spcl132 — op60 Miscast Magic: spell-failure chance 25% -> 10%
COPY_EXISTING ~spcl132.eff~ ~override/spcl132.eff~
  WRITE_LONG  0x1c 10             // param1 = miscast %

// spandl15 — op67 Summon (skelwasu): summon power/level 3 -> 8
COPY_EXISTING ~spandl15.eff~ ~override/spandl15.eff~
  WRITE_LONG  0x18 8              // power

// spandead — op67 Summon (ghastsu): summon power/level 3 -> 8
COPY_EXISTING ~spandead.eff~ ~override/spandead.eff~
  WRITE_LONG  0x18 8              // power

// archstun — op12 HP: Damage (piercing): power 1 -> 0
COPY_EXISTING ~archstun.eff~ ~override/archstun.eff~
  WRITE_LONG  0x18 0              // power

// wish14a/b/c — op122 Create Inventory Item: repoint wand, count 5 -> 1,
// timing 9 (perm-after-death) -> 1 (instant/permanent)
COPY_EXISTING ~wish14a.eff~ ~override/wish14a.eff~
  WRITE_LONG  0x1c 1              // param1 = item count
  WRITE_BYTE  0x24 1              // timing mode
  WRITE_ASCII 0x30 ~S!wand01~ #8  // item to create

COPY_EXISTING ~wish14b.eff~ ~override/wish14b.eff~
  WRITE_LONG  0x1c 1              // param1 = item count
  WRITE_BYTE  0x24 1              // timing mode
  WRITE_ASCII 0x30 ~S!wand02~ #8  // item to create

COPY_EXISTING ~wish14c.eff~ ~override/wish14c.eff~
  WRITE_LONG  0x1c 1              // param1 = item count
  WRITE_BYTE  0x24 1              // timing mode
  WRITE_ASCII 0x30 ~S!wand03~ #8  // item to create

// demosum1 — op67 Summon: repoint summoned creature -> S!ladyde
COPY_EXISTING ~demosum1.eff~ ~override/demosum1.eff~
  WRITE_ASCII 0x30 ~S!ladyde~ #8  // creature to summon

// dglab01 — op67 Summon: repoint summoned creature -> S!lady3
COPY_EXISTING ~dglab01.eff~ ~override/dglab01.eff~
  WRITE_ASCII 0x30 ~S!lady3~ #8   // creature to summon

// daystar2 — op12 HP: Damage: type magic -> slashing
COPY_EXISTING ~daystar2.eff~ ~override/daystar2.eff~
  WRITE_LONG  0x20 0x01000000     // param2 = slashing, Normal

// dbldead — op12 HP: Damage: type magic -> slashing
COPY_EXISTING ~dbldead.eff~ ~override/dbldead.eff~
  WRITE_LONG  0x20 0x01000000     // param2 = slashing, Normal

// spdeath — op67 Summon: repoint summoned creature -> WEREGR01
COPY_EXISTING ~spdeath.eff~ ~override/spdeath.eff~
  WRITE_ASCII 0x30 ~WEREGR01~ #8  // creature to summon

// bolt* — op12 HP: Damage: type magic -> piercing. WRITE_SHORT sets only the
// damage-type hi-word of param2, preserving the mode low word — do NOT collapse
// to a WRITE_LONG (0x0010 << 16 = 0x00100000 piercing).
COPY_EXISTING ~boltprim.eff~ ~override/boltprim.eff~
  WRITE_SHORT 0x22 16             // param2 hi-word -> piercing

COPY_EXISTING ~boltund.eff~ ~override/boltund.eff~
  WRITE_SHORT 0x22 16             // param2 hi-word -> piercing
  WRITE_LONG  0x38 4              // dice thrown 8 -> 4

COPY_EXISTING ~boltelem.eff~ ~override/boltelem.eff~
  WRITE_SHORT 0x22 16             // param2 hi-word -> piercing

COPY_EXISTING ~boltdem.eff~ ~override/boltdem.eff~
  WRITE_SHORT 0x22 16             // param2 hi-word -> piercing

// S!bolgia — clone of the (now piercing) boltdem with dice 10 -> 5
COPY_EXISTING ~boltdem.eff~ ~override/S!bolgia.eff~
  WRITE_LONG  0x38 5              // dice thrown

// WISH14H — op122 Create Magic Item: retired Wand of Cursing -> Wand of Magic Missiles
COPY_EXISTING ~WISH14H.eff~ ~override/WISH14H.eff~
  WRITE_EVALUATED_ASCII 0x30 ~wand03~ #8  // resource
