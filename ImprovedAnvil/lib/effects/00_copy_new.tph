/// Build new effects ///
//
// Each effect is constructed field-by-field by S!MAKE_EFF (lib/tpa/effects.tpa)
// from a one-time CREATE blank. This file is the source of truth for the mod's
// standalone effects; the `//` comment on each block decodes its opcode, params
// and resource (per docs/iesdp). Originally machine-generated from the retired
// resources/effects/*.eff binaries by spec/tools/eff_emit.py.

// One-time blank EFF prototype. CREATE ignores SILENT and un-silences the
// install, so do it once and restore silence.
OUTER_SET eff_silent = (IS_SILENT) ? 1 : 0
CREATE ~eff~ ~S!blanke~
ACTION_IF (eff_silent = 1) BEGIN SILENT END

// S!dragon: Spell Effect: Damage vs. Creature Type Modifier: RACE DRAGON
COPY_EXISTING ~S!blanke.eff~ ~override/S!dragon.eff~
  LPF ~S!MAKE_EFF~ INT_VAR opcode = 179 param1 = 146 param2 = 4 timing = 1 param3 = 5 END

