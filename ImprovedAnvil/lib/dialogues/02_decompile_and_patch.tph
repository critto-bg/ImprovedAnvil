/// decompile and patch existing dialogue files ///

COPY_EXISTING ~PPRIDD.DLG~ ~override~
 DECOMPILE_AND_PATCH BEGIN
   REPLACE_TEXTUALLY ~PartyHasItem("MISC8Z")~ ~PartyHasItem("MISC8Z") Global("openHead","AR1512",0)~
 END

