/// apply item replacements to store sale entries ///

ACTION_PHP_EACH item_replacements AS record => int BEGIN
  ACTION_IF "%record_0%" STRING_EQUAL_CASE "sto" AND FILE_EXISTS_IN_GAME "%record_1%" BEGIN
    COPY_EXISTING ~%record_1%~ ~override~
      LPF ~S!FIND_AND_REPLACE_STORE_ITEM~ STR_VAR to_replace = EVALUATE_BUFFER "%record_2%" replace_with = EVALUATE_BUFFER "%record_3%" END
      BUT_ONLY
  END
END
