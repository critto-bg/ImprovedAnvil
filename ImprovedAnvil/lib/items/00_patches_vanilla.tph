// monk fists, level 12-14: 2d8+3, +3
COPY_EXISTING ~mfist6.itm~ ~override/mfist6.itm~
  SAY NAME1 @10192
  SAY NAME2 @10192

  WRITE_LONG 0x060 3  // enchantment

  LPF ALTER_ITEM_HEADER
    INT_VAR
      header_type  = 1  // melee
      thac0_bonus  = 3
      dicesize     = 8
      dicenumber   = 2
      damage_bonus = 3
  END

  BUT_ONLY

// monk fists, level 15-18: 2d8+4, +4
COPY_EXISTING ~mfist7.itm~ ~override/mfist7.itm~
  SAY NAME1 @10193
  SAY NAME2 @10193

  WRITE_LONG 0x060 4  // enchantment

  LPF ALTER_ITEM_HEADER
    INT_VAR
      header_type  = 1  // melee
      thac0_bonus  = 4
      dicesize     = 8
      dicenumber   = 2
      damage_bonus = 4
  END

  BUT_ONLY

// monk fists, level 19-24: 2d10+4, +4
COPY_EXISTING ~mfist8.itm~ ~override/mfist8.itm~
  SAY NAME1 @10193
  SAY NAME2 @10193

  WRITE_LONG 0x060 4  // enchantment

  LPF ALTER_ITEM_HEADER
    INT_VAR
      header_type  = 1  // melee
      thac0_bonus  = 4
      dicesize     = 10
      dicenumber   = 2
      damage_bonus = 4
  END

  BUT_ONLY

// items patched only to repoint their description off the shared stock strref
// (retiring lib/core/strings.tph overrides; not otherwise patched here). Some share a
// description with an item patched above (repointed to the same @N).
COPY_EXISTING ~brac07.itm~ ~override/brac07.itm~     SAY DESC @9039   // Gauntlets of Dexterity
COPY_EXISTING ~brac18.itm~ ~override/brac18.itm~     SAY DESC @10131  // Gloves of Missile Snaring
COPY_EXISTING ~ttwand.itm~ ~override/ttwand.itm~     SAY DESC @10090  // wand (pillar of flame) [shared with wand11]
COPY_EXISTING ~ringpico.itm~ ~override/ringpico.itm~ SAY DESC @10112  // Ring of Earth Elemental Command [shared with ring29]

