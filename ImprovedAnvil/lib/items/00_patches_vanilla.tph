// Malla's Soul Stone
COPY_EXISTING ~amsoul01.itm~ ~override/amsoul01.itm~
  SAY DESC @10100  // Amulet of Power
  WRITE_LONG  0x008 6970  // unidentified name: "Gemstone"
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT BIT25))  // flags: - toggle crit aversion

  // equipped: - Stat: Constitution Modifier: +1 (cumulative)
  LPF DELETE_EFFECT
    INT_VAR
      check_headers = 0
      match_opcode  = 10
      multi_match   = 1
  END

  // abil 0 (magical): clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
  END

  // abil 0 (magical): + Cure: Poison
  LPF ADD_ITEM_EFFECT
    INT_VAR
      header        = 1
      type          = 99
      opcode        = 11
      target        = 2
      power         = 4
      timing        = 1
      resist_dispel = 3
      insert_point  = 0
  END

