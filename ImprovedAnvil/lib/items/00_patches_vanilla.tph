// Shield Amulet
COPY_EXISTING ~amul15.itm~ ~override/amul15.itm~
  SAY DESC @10157  // Amulet (command-word)
  WRITE_LONG  0x01e 0x60725e80  // usability mask: unusable by Cleric, Cleric/Thief, Cleric/Ranger, Fighter, Fighter/Druid, Fighter/Cleric, Fighter/Thief, Paladin, Ranger, Thief, Monk, Druid/Shaman
  READ_BYTE   0x029 "kitusability1"
  WRITE_BYTE  0x029 ("%kitusability1%" BOR BIT6)  // kit usability 1: + Barbarian
  WRITE_BYTE  0x02a          9  // min intelligence
  WRITE_LONG  0x034       7500  // price

  // abil 0 (magical): header fields
  LPF ALTER_ITEM_HEADER
    INT_VAR
      header         = 1
      primary_type   = 0
      secondary_type = 0
  END

  // abil 0 (magical): Spell: Cast Spell (at Creature) ~SPWI114~ (Shield) (1,1)
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 0
      header        = 0
      match_opcode  = 146
      multi_match   = 1
      parameter1    = 10
  END
  BUT_ONLY

