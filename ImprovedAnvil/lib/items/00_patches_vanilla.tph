// Attack
COPY_EXISTING ~earthrn.itm~ ~override/earthrn.itm~
  READ_LONG   0x018 "flags"
  WRITE_LONG  0x018 ("%flags%" BAND (BNOT (BIT13 BOR BIT24)))  // flags: - forbid off-hand, undispellable
  WRITE_LONG  0x060 3  // enchantment

  // equipped: clear all effects
  LPF DELETE_EFFECT
    INT_VAR
      check_headers = 0
  END

  // equipped: + Protection: from Weapons (0,2)
  LPF ADD_ITEM_EQEFFECT
    INT_VAR
      opcode       = 120
      target       = 1
      parameter2   = 2
      timing       = 2
      insert_point = 0
  END
  BUT_ONLY

