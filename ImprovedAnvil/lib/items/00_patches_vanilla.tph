// Ring of Fire Control
COPY_EXISTING ~ring27.itm~ ~override/ring27.itm~
  SAY DESC @10089  // Ring of Fire Control
  // remove ability 2 (magical) and its 1 effects (raw: a same-type ability survives, DELETE_ITEM_HEADER would hit both)
  DELETE_BYTES 0x1da 0x30 // its feature blocks
  DELETE_BYTES 0xe2 0x38 // the header
  WRITE_SHORT 0x68 2 // header count
  WRITE_LONG 0x6a 0xe2 // feature block offset
  READ_LONG   0x098 "abilflags"
  WRITE_LONG  0x098 ("%abilflags%" BAND (BNOT BIT9))  // abil 0: flags: - breaks sanctuary/invisibility
  READ_LONG   0x0d0 "abilflags"
  WRITE_LONG  0x0d0 ("%abilflags%" BAND (BNOT BIT9))  // abil 1: flags: - breaks sanctuary/invisibility

