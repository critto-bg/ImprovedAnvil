/// apply custom colouring schemes to various creatures ///

// Colouring for the mod's own (shipped) creatures is baked into their
// definitions (defs/creatures, `colour_scheme` key) and compiled into the
// binaries — only vanilla creatures and creatures created at install time
// (05_patches_new.tph werewolves/loups garous) are coloured here.

// Gem Golem //

ACTION_FOR_EACH ~file~ IN
                ~AMTARC01~
                ~HLARCH~
BEGIN
  LAF ~S!CHANGE_CREATURE_COLOURS~
    STR_VAR
      file = EVALUATE_BUFFER "%file%"
      opcode = "52"
      parameter1 = "202113024"
  END
END

// Coin Golem //

