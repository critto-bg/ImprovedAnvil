  ADD_KNOWN_SPELL ~SPWI704~ #6 ~wizard~ // SPWI704 (Ruby Ray of Reversal)
  ADD_KNOWN_SPELL ~SPWI713~ #6 ~wizard~ // SPWI713 (Finger of Death)
  ADD_KNOWN_SPELL ~SPWI715~ #6 ~wizard~ // SPWI715 (Power Word, Stun)
  ADD_KNOWN_SPELL ~SPWI813~ #7 ~wizard~ // SPWI813 (Maze)
  ADD_KNOWN_SPELL ~SPWI899~ #7 ~wizard~ // SPWI899 (Symbol, Fear)

  REMOVE_MEMORIZED_SPELLS
  ADD_MEMORIZED_SPELL ~SPWI112~ #0 ~wizard~ ( 4 ) // SPWI112 (Magic Missile)
  ADD_MEMORIZED_SPELL ~SPWI118~ #0 ~wizard~ ( 1 ) // SPWI118 (Chromatic Orb)
  ADD_MEMORIZED_SPELL ~SPWI211~ #1 ~wizard~ ( 3 ) // SPWI211 (Melf's Acid Arrow)
  ADD_MEMORIZED_SPELL ~SPWI212~ #1 ~wizard~ ( 2 ) // SPWI212 (Mirror Image)
  ADD_MEMORIZED_SPELL ~SPWI308~ #2 ~wizard~ ( 1 ) // SPWI308 (Lightning Bolt)
  ADD_MEMORIZED_SPELL ~SPWI303~ #2 ~wizard~ ( 1 ) // SPWI303 (Flame Arrow)
  ADD_MEMORIZED_SPELL ~SPWI302~ #2 ~wizard~ ( 1 ) // SPWI302 (Remove Magic)
  ADD_MEMORIZED_SPELL ~SPWI305~ #2 ~wizard~ ( 1 ) // SPWI305 (Haste)
  ADD_MEMORIZED_SPELL ~SPWI408~ #3 ~wizard~ ( 1 ) // SPWI408 (Stoneskin)
  ADD_MEMORIZED_SPELL ~SPWI406~ #3 ~wizard~ ( 1 ) // SPWI406 (Minor Globe of Invulnerability)
  ADD_MEMORIZED_SPELL ~SPWI412~ #3 ~wizard~ ( 1 ) // SPWI412 (Greater Malison)
  ADD_MEMORIZED_SPELL ~SPWI507~ #4 ~wizard~ ( 1 ) // SPWI507 (Hold Monster)
  ADD_MEMORIZED_SPELL ~SPWI504~ #4 ~wizard~ ( 1 ) // SPWI504 (Monster Summoning III)
  ADD_MEMORIZED_SPELL ~SPWI508~ #4 ~wizard~ ( 1 ) // SPWI508 (Chaos)
  ADD_MEMORIZED_SPELL ~SPWI616~ #5 ~wizard~ ( 1 ) // SPWI616 (Disintegrate)
  ADD_MEMORIZED_SPELL ~SPWI609~ #5 ~wizard~ ( 1 ) // SPWI609 (True Sight)
  ADD_MEMORIZED_SPELL ~SPWI605~ #5 ~wizard~ ( 1 ) // SPWI605 (Death Spell)
  ADD_MEMORIZED_SPELL ~SPWI602~ #5 ~wizard~ ( 1 ) // SPWI602 (Globe of Invulnerability)
  ADD_MEMORIZED_SPELL ~SPWI601~ #5 ~wizard~ ( 1 ) // SPWI601 (Invisible Stalker)
  ADD_MEMORIZED_SPELL ~SPWI608~ #5 ~wizard~ ( 1 ) // SPWI608 (Pierce Magic)
  ADD_MEMORIZED_SPELL ~SPWI624~ #5 ~wizard~ ( 1 ) // SPWI624 (Summon Nishruu)
  ADD_MEMORIZED_SPELL ~SPWI715~ #6 ~wizard~ ( 1 ) // SPWI715 (Power Word, Stun)
  ADD_MEMORIZED_SPELL ~SPWI713~ #6 ~wizard~ ( 1 ) // SPWI713 (Finger of Death)
  ADD_MEMORIZED_SPELL ~SPWI704~ #6 ~wizard~ ( 1 ) // SPWI704 (Ruby Ray of Reversal)
  ADD_MEMORIZED_SPELL ~SPWI701~ #6 ~wizard~ ( 1 ) // SPWI701 (Spell Turning)
  ADD_MEMORIZED_SPELL ~SPWI899~ #7 ~wizard~ ( 1 ) // SPWI899 (Symbol, Fear)
  ADD_MEMORIZED_SPELL ~SPWI813~ #7 ~wizard~ ( 1 ) // SPWI813 (Maze)

  READ_LONG   0x2a8 "mi_off"
  FOR (row = 0; row < 7; row = row + 1) BEGIN // no priest spell slots
    WRITE_SHORT ("%mi_off%" + (0x10 * "%row%") + 0x02) 0
    WRITE_SHORT ("%mi_off%" + (0x10 * "%row%") + 0x04) 0
  END
  WRITE_SHORT ("%mi_off%" + (0x10 * 15) + 0x02)       0 // memorization (wizard level 9): memorizable
  WRITE_SHORT ("%mi_off%" + (0x10 * 15) + 0x04)       0 // memorization (wizard level 9): memorizable (effective)

  LPF ADD_CRE_EFFECT INT_VAR opcode = 16 target = 1 timing = 9 insert_point = (0 - 1) END // State: Haste
  LPF ADD_CRE_EFFECT INT_VAR opcode = 233 target = 1 parameter1 = 2 parameter2 = 106 timing = 9 insert_point = (0 - 1) END // Stat: Proficiency Modifier
  LPF ADD_CRE_EFFECT INT_VAR opcode = 233 target = 1 parameter1 = 2 parameter2 = 102 timing = 9 insert_point = (0 - 1) END // Stat: Proficiency Modifier
  LPF ADD_CRE_EFFECT INT_VAR opcode = 189 target = 1 parameter1 = 4 timing = 9 insert_point = (0 - 1) END // Stat: Casting Time Modifier
  LPF ADD_CRE_EFFECT INT_VAR opcode = 0 target = 1 parameter1 = 9 parameter2 = 2 timing = 9 insert_point = (0 - 1) END // Stat: AC vs. Damage Type Modifier

  REMOVE_CRE_ITEMS
