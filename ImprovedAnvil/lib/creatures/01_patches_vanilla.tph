/// patch vanilla creatures (converted from full-file copies; each block
/// rebuilds the shipped override from the stock resource) ///

// Ancient Dragon
COPY_EXISTING ~fsdragon.cre~ ~override/fsdragon.cre~
  SAY NAME1     @401
  SAY NAME2     @401
  WRITE_LONG  0x14    136000        // xp
  WRITE_LONG  0x1c     65000        // gold
  WRITE_SHORT 0x24       360        // current hp
  WRITE_SHORT 0x26       360        // max hp
  WRITE_LONG  0x28      4608        // animation
  WRITE_ASCII 0x34   ~NONE~ #8      // small portrait
  WRITE_ASCII 0x3c   ~NONE~ #8      // large portrait
  WRITE_SHORT 0x46   (0 - 18)       // base ac
  WRITE_SHORT 0x48   (0 - 18)       // effective ac
  WRITE_SHORT 0x4c         0        // ac vs missile
  WRITE_BYTE  0x52   (0 - 18)       // thac0
  WRITE_BYTE  0x53         1        // number of attacks
  WRITE_BYTE  0x54         2        // save vs death
  WRITE_BYTE  0x55         3        // save vs wands
  WRITE_BYTE  0x58         4        // save vs spell
  WRITE_BYTE  0x59       100        // resist fire
  WRITE_BYTE  0x5a        75        // resist cold
  WRITE_BYTE  0x5b        75        // resist electricity
  WRITE_BYTE  0x5c        75        // resist acid
  WRITE_BYTE  0x5d       100        // resist magic
  WRITE_BYTE  0x5e       100        // resist magic fire
  WRITE_BYTE  0x5f        75        // resist magic cold
  WRITE_BYTE  0x60        70        // resist slashing
  WRITE_BYTE  0x61        70        // resist crushing
  WRITE_BYTE  0x62        70        // resist piercing
  WRITE_BYTE  0x63       100        // resist missile
  WRITE_BYTE  0x234       39        // level
  WRITE_BYTE  0x235       32        // level secondary class
  WRITE_BYTE  0x236       39        // level third class
  WRITE_BYTE  0x23a       18        // intelligence
  WRITE_BYTE  0x23b       18        // wisdom
  WRITE_BYTE  0x23c       21        // dexterity
  WRITE_BYTE  0x23d       14        // constitution
  WRITE_BYTE  0x23f       19        // morale
  WRITE_SHORT 0x242        1        // morale Recovery
  WRITE_ASCII 0x248  ~S!FSDRAG~ #8  // override script
  WRITE_ASCII 0x250  ~NONE~ #8      // class script
  WRITE_ASCII 0x258  ~NONE~ #8      // race script
  WRITE_ASCII 0x260  ~NONE~ #8      // general script
  WRITE_ASCII 0x268  ~NONE~ #8      // default script
  WRITE_BYTE  0x273       17        // class (FIGHTER_MAGE_CLERIC)
  WRITE_ASCII 0x280  ~FSDRAGON~ #32 // death variable
  WRITE_ASCII 0x2cc  ~IAFSDRAG~ #8  // dialog

  REMOVE_CRE_EFFECTS // clear the effect list (19 effects)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 292 target = 1 parameter2 = 1 timing = 9 insert_point = (0 - 1) END // Protection: Backstab
  LPF ADD_CRE_EFFECT INT_VAR opcode = 193 target = 1 parameter2 = 1 timing = 9 insert_point = (0 - 1) END // Spell Effect: Invisible Detection by Script
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 25 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #25 (State: Poison)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 40 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #40 (State: Slow)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 126 target = 1 parameter1 = 200 parameter2 = 2 timing = 9 insert_point = (0 - 1) END // Stat: Movement Modifier
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 211 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #211 (Spell Effect: Imprisonment)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 10 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #10 (Stat: Constitution Modifier)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 19 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #19 (Stat: Intelligence Modifier)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 15 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #15 (Stat: Dexterity Modifier)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 44 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #44 (Stat: Strength Modifier)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 49 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #49 (Stat: Wisdom Modifier)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 6 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #6 (Stat: Charisma Modifier)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 parameter2 = 54 timing = 9 insert_point = (0 - 1) END // Protection: from Opcode #54 (Stat: THAC0 Modifier)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 173 target = 1 parameter1 = 100 timing = 9 insert_point = (0 - 1) END // Stat: Poison Resistance Modifier
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPCL911B~ END // Spell: Protection from Spell: SPCL911B
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPCL910B~ END // Spell: Protection from Spell: SPCL910B
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPCL411~ END // Spell: Protection from Spell: SPCL411
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPCL415~ END // Spell: Protection from Spell: SPCL415
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPWI911~ END // Spell: Protection from Spell: SPWI911 (Meteor Swarm)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPWI810~ END // Spell: Protection from Spell: SPWI810 (Incendiary Cloud)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPPR705~ END // Spell: Protection from Spell: SPPR705 (Fire Storm)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPINI39~ END // Spell: Protection from Spell: SPINI39 (Grave Silence)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 insert_point = (0 - 1) STR_VAR resource = ~SPPR717~ END // Spell: Protection from Spell: SPPR717 (Creeping Doom)
  LPF ADD_CRE_EFFECT INT_VAR opcode = 16 target = 1 parameter2 = 1 timing = 9 insert_point = (0 - 1) END // State: Haste
  LPF ADD_CRE_EFFECT INT_VAR opcode = 310 target = 1 parameter2 = 1 timing = 9 insert_point = (0 - 1) END // Protection: from Timestop
  LPF ADD_CRE_EFFECT INT_VAR opcode = 120 target = 1 parameter2 = 2 timing = 9 insert_point = (0 - 1) END // Protection: from Weapons
  LPF ADD_CRE_EFFECT INT_VAR opcode = 31 target = 1 parameter1 = 25 timing = 9 insert_point = (0 - 1) END // Stat: Magic Damage Resistance Modifier

  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~HELMNOAN~ #0 #0 #0     ~NONE~ ~HELMET~        // Undroppable helmet with no animation
  ADD_CRE_ITEM ~DRAGRING~ #0 #0 #0     ~NONE~ ~RRING~         // Ring
  ADD_CRE_ITEM ~S!CTRLY~  #0 #0 #0     ~UNSTEALABLE~ ~AMULET~
  ADD_CRE_ITEM ~SAREVIMM~ #0 #0 #0     ~NONE~ ~BELT~
  ADD_CRE_ITEM ~S!DCLAW~  #0 #0 #0     ~NONE~ ~WEAPON1~       // Dragon Claw
  ADD_CRE_ITEM ~SW1H70~   #0 #0 #0     ~NONE~ ~INV7~          // Hindo's Doom +3
  ADD_CRE_ITEM ~S!MISC02~ #0 #0 #0     ~UNSTEALABLE~ ~INV8~   // Permanency Scroll
  ADD_CRE_ITEM ~S!SCRL25~ #0 #0 #0     ~UNSTEALABLE~ ~INV9~   // Monster Summoning VII
  ADD_CRE_ITEM ~S!SCALER~ #0 #0 #0     ~UNSTEALABLE~ ~INV10~  // Great Wyrm Scales
  ADD_CRE_ITEM ~HALB04~   #0 #0 #0     ~UNSTEALABLE~ ~INV13~  // Dragon's Bane +3
  ADD_CRE_ITEM ~SCRL9X~   #0 #0 #0     ~UNSTEALABLE~ ~INV14~  // Black Blade of Disaster
  ADD_CRE_ITEM ~SCRLB4~   #0 #0 #0     ~UNSTEALABLE~ ~INV15~  // Wish
  ADD_CRE_ITEM ~PLOT05D~  #0 #0 #0     ~NONE~ ~INV16~         // Warrior's Skull
  ADD_CRE_ITEM ~MISC07~   #30000 #0 #0 ~UNSTEALABLE~ ~INV1~   // Gold
  ADD_CRE_ITEM ~MISC07~   #30000 #0 #0 ~UNSTEALABLE~ ~INV2~   // Gold

