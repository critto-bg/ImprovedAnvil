  WRITE_SHORT 0x24       132       // current hp
  WRITE_SHORT 0x26       132       // max hp
  WRITE_LONG  0x28     24833       // animation
  WRITE_ASCII 0x34   ~~ #8         // removes small portrait
  WRITE_ASCII 0x3c   ~~ #8         // removes large portrait
  WRITE_SHORT 0x46   (0 - 10)      // base ac
  WRITE_SHORT 0x48   (0 - 10)      // effective ac
  WRITE_BYTE  0x52   (0 - 9)       // thac0
  WRITE_BYTE  0x54         3       // save vs death
  WRITE_BYTE  0x55         3       // save vs wands
  WRITE_BYTE  0x56         4       // save vs polymorph
  WRITE_BYTE  0x57         4       // save vs breath
  WRITE_BYTE  0x58         4       // save vs spell
  WRITE_BYTE  0x59       100       // resist fire
  WRITE_BYTE  0x5e       100       // resist magic fire
  WRITE_BYTE  0x60        50       // resist slashing
  WRITE_BYTE  0x61        50       // resist crushing
  WRITE_BYTE  0x62        50       // resist piercing
  WRITE_BYTE  0x63       100       // resist missile
  WRITE_BYTE  0x66        18       // lore
  WRITE_BYTE  0x6f         1       // proficiency 1
  WRITE_BYTE  0x75         1       // proficiency 7
  WRITE_LONG  0xb8   (0 - 1)       // soundset 5
  WRITE_LONG  0xc8     61989       // soundset 9
  WRITE_LONG  0xcc     61990       // soundset 10
  WRITE_LONG  0xec     61991       // soundset 18
  WRITE_LONG  0xf0     61992       // soundset 19
  WRITE_LONG  0x10c    61987       // soundset 26
  WRITE_LONG  0x110    61988       // soundset 27
  WRITE_LONG  0x114  (0 - 1)       // soundset 28
  WRITE_LONG  0x118  (0 - 1)       // soundset 29
  WRITE_BYTE  0x234       30       // level
  WRITE_BYTE  0x235       25       // level secondary class
  WRITE_BYTE  0x238       18       // strength
  WRITE_BYTE  0x239       91       // strength % bonus
  WRITE_BYTE  0x23a       18       // intelligence
  WRITE_BYTE  0x23b       16       // wisdom
  WRITE_BYTE  0x23c       18       // dexterity
  WRITE_BYTE  0x23d       14       // constitution
  WRITE_BYTE  0x23e       10       // charisma
  WRITE_BYTE  0x23f       19       // morale
  WRITE_SHORT 0x242        1       // morale Recovery
  WRITE_ASCII 0x250  ~S!HLMAGE~ #8 // class script
  WRITE_ASCII 0x258  ~NONE~ #8     // race script
  WRITE_ASCII 0x260  ~NONE~ #8     // general script
  WRITE_ASCII 0x268  ~NONE~ #8     // default script
  WRITE_BYTE  0x272        3       // race
  WRITE_BYTE  0x273        7       // class (FIGHTER_MAGE)
  WRITE_BYTE  0x27b       34       // alignment (NEUTRAL)
  WRITE_ASCII 0x280  ~HLMAGE~ #32  // death variable
  WRITE_ASCII 0x2cc  ~HLMAGE~ #8   // dialog

  REMOVE_KNOWN_SPELL ~SPWI217~
  REMOVE_KNOWN_SPELL ~SPWI503~
  REMOVE_KNOWN_SPELL ~SPWI612~
  ADD_KNOWN_SPELL ~SPWI118~ #0 ~wizard~ // SPWI118 (Chromatic Orb)
  ADD_KNOWN_SPELL ~SPWI211~ #1 ~wizard~ // SPWI211 (Melf's Acid Arrow)
  ADD_KNOWN_SPELL ~SPWI219~ #1 ~wizard~ // SPWI219 (Vocalize)
