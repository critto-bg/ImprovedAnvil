/// generic, resource-agnostic patch helpers ///

// Repoint the param1 (a strref) of every display-string effect (op139 by default,     //
// op206 etc. via match_opcode) whose current param1 == old_strref, to new_strref.     //
// Works on both .itm and .spl (identical feature-block layout: table at 0x6a, 0x30    //
// bytes each, opcode at +0x00, param1 at +0x04).                                      //

DEFINE_PATCH_FUNCTION ~S!REPOINT_DISPLAY_STRING~
INT_VAR
  old_strref   = "-1"
  new_strref   = "-1"
  match_opcode = 139
BEGIN
  PATCH_IF (BUFFER_LENGTH > 0x71) BEGIN
    READ_LONG 0x6a fx_off
    SET fx_n = (BUFFER_LENGTH - fx_off) / 0x30
    SET found = 0

    FOR (index = 0; index < fx_n; index = index + 1) BEGIN
      READ_SHORT (fx_off + 0x30 * index       ) opcode
      READ_LONG  (fx_off + 0x30 * index + 0x04) param1

      PATCH_IF (opcode = match_opcode) AND (param1 = old_strref) BEGIN
        WRITE_LONG (fx_off + 0x30 * index + 0x04) new_strref
        SET found = found + 1
      END
    END

    PATCH_IF (found = 0) BEGIN
      PATCH_FAIL "S!REPOINT_DISPLAY_STRING: op%match_opcode% param1=%old_strref% not found in %SOURCE_RES%"
    END
  END
END
